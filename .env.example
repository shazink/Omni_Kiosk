# ==============================================================================
# OmniKiosk Environment Configuration Template (.env.example)
# Duplicate this file as .env and populate your API credentials.
# ==============================================================================

# LLM Provider: "gemini", "groq", or "local"
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# LLM Generation Constraints
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=150
LLM_SENTENCE_LIMIT=2

# Portal & Network Configuration
OMNIKIOSK_PORTAL_URL=http://localhost:3000
OMNIKIOSK_PORTAL_PORT=3000

# Artifact Paths
OMNIKIOSK_SCHEMA_PATH=current_form_schema.json
OMNIKIOSK_DOWNLOADS_DIR=downloads

# Module 3: Document Scanner & Spatial Guidance
SCANNER_SHARPNESS_THRESHOLD=85.0
SCANNER_STABILITY_FRAMES=15
SCANNER_OFFSET_THRESHOLD_PX=40
SCANNER_SKEW_THRESHOLD_DEG=5.0
SCANNER_MIN_CONTOUR_AREA_RATIO=0.20
SCANNER_CAMERA_DEVICE=0
SCANNER_FRAME_WIDTH=640
SCANNER_FRAME_HEIGHT=480
SCANNER_VOICE_OVERRIDE_PHRASE=capture now

# Security Settings
STRICT_PII_SCRUBBING=true
